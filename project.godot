[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
driver/depth_prepass/enable=false
camera/depth_of_field/depth_of_field_bokeh_shape=0
camera/depth_of_field/depth_of_field_bokeh_quality=0
environment/ssao/quality=1
anti_aliasing/quality/use_debanding=true
scaling_3d/mode=2
scaling_3d/scale=0.77

[shader_globals]

zwervr_tint_kaart={
"type": "sampler2D",
"value": ""
}
zwervr_tint_gebied={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
zwervr_variatie={
"type": "float",
"value": 0.0
}
